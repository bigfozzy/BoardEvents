{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["plan_id", "created_at", "priority", "confidence_score", "tasks"],
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Уникальный идентификатор плана"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Дата и время создания плана (ISO 8601)"
    },
    "priority": {
      "type": "string",
      "enum": ["high", "medium", "low"],
      "description": "Общий приоритет плана"
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Уровень уверенности в качестве плана (0.0-1.0)"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "priority_level", "acceptance_criteria", "estimated_time", "status"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Уникальный идентификатор задачи"
          },
          "title": {
            "type": "string",
            "description": "Название задачи"
          },
          "description": {
            "type": "string",
            "description": "Подробное описание задачи"
          },
          "priority_level": {
            "type": "string",
            "enum": ["🔴 Critical", "🟡 Important", "🟢 Optional"],
            "description": "Уровень приоритета задачи с эмодзи"
          },
          "acceptance_criteria": {
            "type": "string",
            "description": "Критерий приемки (как проверить выполнение)"
          },
          "estimated_time": {
            "type": "string",
            "description": "Оценка времени выполнения"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Список идентификаторов задач-зависимостей"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Список файлов для изменения"
          },
          "status": {
            "type": "string",
            "enum": ["To Do", "In Progress", "Done"],
            "description": "Статус выполнения задачи"
          }
        },
        "additionalProperties": false
      },
      "description": "Список задач плана"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "mitigation"],
        "properties": {
          "description": {
            "type": "string",
            "description": "Описание риска или блокера"
          },
          "mitigation": {
            "type": "string",
            "description": "План смягчения риска"
          }
        },
        "additionalProperties": false
      },
      "description": "Список рисков и блокеров"
    }
  },
  "additionalProperties": false
}