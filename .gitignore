## Runtime data / logs (never commit)
# Legacy C# app wrote these next to its .exe, i.e. inside legacy-csharp/
legacy-csharp/Tasks/
legacy-csharp/Logs/
legacy-csharp/Results/
legacy-csharp/Temp/
*.log
legacy-csharp/tasks.json
legacy-csharp/tasks.json.bak*
legacy-csharp/tasks.json.tmp
legacy-csharp/tasks.json.bak.tmp

## Robot: local settings (contain the mail password)
robot/config.php
# результат в robot/data/ коммитится - он и есть пример работы;
# не коммитится только состояние слайса (см. robot/.gitignore)
robot/data/*_state.json
robot/data/*_state.json.tmp

